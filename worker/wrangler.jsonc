{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "k-kiron-profile-assistant",
  "main": "index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "DailyQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyQuota"] }],
  "vars": { "ALLOWED_ORIGIN": "https://k-kiron.github.io" },
  "observability": { "enabled": false },
  "send_metrics": false
}
